{{!include(/^public/.*/)}}
{{!include(favicon.ico)}}
{{!include(logo.svg)}}
<!DOCTYPE html>
<html {{#_lang}}lang="{{_lang}}"{{/_lang}}>
<head>
    <meta charset="utf-8">

    {{#redirect_url}}
    <meta http-equiv="refresh" content="0;URL='{{redirect_url}}'">
    {{/redirect_url}}

    {{^redirect_url}}
    <title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}">

    {{#_description}}
    <meta name="description" content="{{_description}}">
    {{/_description}}

    {{#description}}
    <meta name="description" content="{{description}}">
    {{/description}}

    <!-- Open Graph / Discord Embeds -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{_appTitle}}">
    <meta property="og:title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}">

    {{#_description}}
    <meta property="og:description" content="{{_description}}">
    {{/_description}}

    {{^_description}}
        {{#description}}
        <meta property="og:description" content="{{description}}">
        {{/description}}
    {{/_description}}

    <meta property="og:image" content="{{_appBaseUrl}}DiscordIcon.png">

    <!-- Twitter / Large Preview -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}}">

    {{#_description}}
    <meta name="twitter:description" content="{{_description}}">
    {{/_description}}

    {{^_description}}
        {{#description}}
        <meta name="twitter:description" content="{{description}}">
        {{/description}}
    {{/_description}}

    <meta name="twitter:image" content="{{_appBaseUrl}}DiscordIcon.png">

    <link rel="icon" href="{{_rel}}{{{_appFaviconPath}}}{{^_appFaviconPath}}favicon.ico{{/_appFaviconPath}}">
    <link rel="stylesheet" href="{{_rel}}public/docfx.min.css">
    <link rel="stylesheet" href="{{_rel}}public/main.css">

    <meta name="docfx:navrel" content="{{_navRel}}">
    <meta name="docfx:tocrel" content="{{_tocRel}}">

    {{#_noindex}}
    <meta name="searchOption" content="noindex">
    {{/_noindex}}

    {{#_enableSearch}}
    <meta name="docfx:rel" content="{{_rel}}">
    {{/_enableSearch}}

    {{#_disableNewTab}}
    <meta name="docfx:disablenewtab" content="true">
    {{/_disableNewTab}}

    {{#_disableTocFilter}}
    <meta name="docfx:disabletocfilter" content="true">
    {{/_disableTocFilter}}

    {{#docurl}}
    <meta name="docfx:docurl" content="{{docurl}}">
    {{/docurl}}

    <meta name="loc:inThisArticle" content="{{__global.inThisArticle}}">
    <meta name="loc:searchResultsCount" content="{{__global.searchResultsCount}}">
    <meta name="loc:searchNoResults" content="{{__global.searchNoResults}}">
    <meta name="loc:tocFilter" content="{{__global.tocFilter}}">
    <meta name="loc:nextArticle" content="{{__global.nextArticle}}">
    <meta name="loc:prevArticle" content="{{__global.prevArticle}}">
    <meta name="loc:themeLight" content="{{__global.themeLight}}">
    <meta name="loc:themeDark" content="{{__global.themeDark}}">
    <meta name="loc:themeAuto" content="{{__global.themeAuto}}">
    <meta name="loc:changeTheme" content="{{__global.changeTheme}}">
    <meta name="loc:copy" content="{{__global.copy}}">
    <meta name="loc:downloadPdf" content="{{__global.downloadPdf}}">

    <script type="module" src="./{{_rel}}public/docfx.min.js"></script>

    <script>
        const theme = localStorage.getItem('theme') || 'auto';

        document.documentElement.setAttribute(
            'data-bs-theme',
            theme === 'auto'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : theme
        );
    </script>

    <script>
        const root = document.documentElement;

        const availableFonts = [
            'dpcomic',
            'comic-sans',
            'sans-serif',
            'monospace',
            'system',
            'custom'
        ];

        const documentFont = localStorage.getItem('docfx-document-font') || 'dpcomic';
        const codeFont = localStorage.getItem('docfx-code-font') || 'dpcomic';

        root.setAttribute(
            'data-document-font',
            availableFonts.includes(documentFont) ? documentFont : 'dpcomic'
        );

        root.setAttribute(
            'data-code-font',
            availableFonts.includes(codeFont) ? codeFont : 'dpcomic'
        );

        function restoreCustomFont(type) {
            const font = localStorage.getItem(`docfx-${type}-font-custom`);

            if (font && font.trim()) {
                root.style.setProperty(
                    `--${type}-font`,
                    `${JSON.stringify(font.trim())}, system-ui, sans-serif`
                );
            }
        }

        if (documentFont === 'custom') {
            restoreCustomFont('document');
        }

        if (codeFont === 'custom') {
            restoreCustomFont('code');
        }
    </script>

    {{#_googleAnalyticsTagId}}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{_googleAnalyticsTagId}}"></script>

    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());
        gtag('config', '{{_googleAnalyticsTagId}}');
    </script>
    {{/_googleAnalyticsTagId}}
    {{/redirect_url}}
</head>

{{^redirect_url}}
<body class="tex2jax_ignore" data-layout="{{_layout}}{{layout}}" data-yaml-mime="{{yamlmime}}">
    <header class="bg-body border-bottom">
        {{^_disableNavbar}}
        <nav id="autocollapse" class="navbar navbar-expand-md" role="navigation">
            <div class="container-xxl flex-nowrap">
                <a class="navbar-brand" href="{{_appLogoUrl}}{{^_appLogoUrl}}{{_rel}}index.html{{/_appLogoUrl}}">
                    <img
                        id="logo"
                        class="svg"
                        src="{{_rel}}{{{_appLogoPath}}}{{^_appLogoPath}}logo.svg{{/_appLogoPath}}"
                        alt="{{_appName}}"
                    >
                    {{_appName}}
                </a>

                <button
                    class="btn btn-lg d-md-none border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navpanel"
                    aria-controls="navpanel"
                    aria-expanded="true"
                    aria-label="Hide expanded navbar"
                >
                    <span class="navbar-toggle-label">Hide Expanded Navbar</span>
                </button>

                <div class="collapse navbar-collapse show" id="navpanel">
                    <div id="navbar">
                        {{#_enableSearch}}
                        <form class="search" role="search" id="search">
                            <i class="bi bi-search"></i>
                            <input
                                class="form-control"
                                id="search-query"
                                type="search"
                                disabled
                                placeholder="{{__global.search}}"
                                autocomplete="off"
                                aria-label="Search"
                            >
                        </form>
                        {{/_enableSearch}}

                        <div class="navbar-settings">
                            <div class="dropdown font-settings-menu">
                                <button
                                    class="btn btn-outline-secondary border-0"
                                    type="button"
                                    id="font-settings-toggle"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                    aria-label="Font settings"
                                    title="Font settings"
                                >
                                    <i class="bi bi-gear"></i>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end p-3 font-settings-panel" aria-labelledby="font-settings-toggle">
                                    <h6 class="dropdown-header">Font Settings</h6>

                                    <div class="mb-3">
                                        <label for="document-font-selector" class="form-label">
                                            Document Font
                                        </label>

                                        <select id="document-font-selector" class="form-select">
                                            <option value="dpcomic">DPComic</option>
                                            <option value="comic-sans">Comic Sans (Dyslexia)</option>
                                            <option value="sans-serif">Sans Serif</option>
                                            <option value="monospace">Monospace</option>
                                            <option value="system">System</option>
                                            <option value="custom">Custom...</option>
                                        </select>

                                        <input
                                            id="document-font-custom"
                                            class="form-control mt-2"
                                            type="text"
                                            placeholder="Installed font name"
                                            autocomplete="off"
                                            hidden
                                        >
                                    </div>

                                    <div>
                                        <label for="code-font-selector" class="form-label">
                                            Code Font
                                        </label>

                                        <select id="code-font-selector" class="form-select">
                                            <option value="dpcomic">DPComic</option>
                                            <option value="comic-sans">Comic Sans (Dyslexia)</option>
                                            <option value="sans-serif">Sans Serif</option>
                                            <option value="monospace">Monospace</option>
                                            <option value="system">System</option>
                                            <option value="custom">Custom...</option>
                                        </select>

                                        <input
                                            id="code-font-custom"
                                            class="form-control mt-2"
                                            type="text"
                                            placeholder="Installed font name"
                                            autocomplete="off"
                                            hidden
                                        >
                                    </div>

                                    <hr>

                                    <h6 class="dropdown-header">Reading Layout</h6>

                                    <div class="mb-3">
                                        <label for="document-font-size" class="form-label">
                                            Document Font Size
                                            <output id="document-font-size-value">20px</output>
                                        </label>

                                        <input
                                            id="document-font-size"
                                            class="form-range"
                                            type="range"
                                            min="12"
                                            max="32"
                                            step="1"
                                            value="20"
                                        >
                                    </div>

                                    <div class="mb-3">
                                        <label for="code-font-size" class="form-label">
                                            Code Font Size
                                            <output id="code-font-size-value">18px</output>
                                        </label>

                                        <input
                                            id="code-font-size"
                                            class="form-range"
                                            type="range"
                                            min="10"
                                            max="28"
                                            step="1"
                                            value="18"
                                        >
                                    </div>

                                    <div class="mb-3">
                                        <label for="document-line-height" class="form-label">
                                            Document Line Height
                                            <output id="document-line-height-value">1.5</output>
                                        </label>

                                        <input
                                            id="document-line-height"
                                            class="form-range"
                                            type="range"
                                            min="1"
                                            max="2.5"
                                            step="0.1"
                                            value="1.5"
                                        >
                                    </div>

                                    <div>
                                        <label for="code-line-height" class="form-label">
                                            Code Line Height
                                            <output id="code-line-height-value">1.4</output>
                                        </label>

                                        <input
                                            id="code-line-height"
                                            class="form-range"
                                            type="range"
                                            min="1"
                                            max="2.5"
                                            step="0.1"
                                            value="1.4"
                                        >
                                    </div>

                                    <hr>

                                    <h6 class="dropdown-header">Heading Layout</h6>

                                    <div class="mb-3">
                                        <label for="heading-line-height" class="form-label">
                                            Heading Line Height
                                            <output id="heading-line-height-value">1.2</output>
                                        </label>

                                        <input
                                            id="heading-line-height"
                                            class="form-range"
                                            type="range"
                                            min="1"
                                            max="2"
                                            step="0.1"
                                            value="1.2"
                                        >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
        {{/_disableNavbar}}
    </header>

    <main class="container-xxl">
        {{^_disableToc}}
        <div class="toc-offcanvas">
            <div
                class="offcanvas-md offcanvas-start"
                tabindex="-1"
                id="tocOffcanvas"
                aria-labelledby="tocOffcanvasLabel"
            >
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="tocOffcanvasLabel">Table of Contents</h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#tocOffcanvas"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="offcanvas-body">
                    <nav class="toc" id="toc"></nav>
                </div>
            </div>
        </div>
        {{/_disableToc}}

        <div class="content">
            <div class="actionbar">
                {{^_disableToc}}
                <button
                    class="btn btn-lg border-0 d-md-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#tocOffcanvas"
                    aria-controls="tocOffcanvas"
                    aria-expanded="false"
                    aria-label="Show table of contents"
                >
                    <i class="bi bi-list"></i>
                </button>
                {{/_disableToc}}

                {{^_disableBreadcrumb}}
                <nav id="breadcrumb"></nav>
                {{/_disableBreadcrumb}}
            </div>

            <article data-uid="{{uid}}">
                {{!body}}
            </article>

            {{^_disableContribution}}
            <div class="contribution d-print-none">
                {{#sourceurl}}
                <a href="{{sourceurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
                {{/sourceurl}}

                {{^sourceurl}}
                    {{#docurl}}
                    <a href="{{docurl}}" class="edit-link">{{__global.improveThisDoc}}</a>
                    {{/docurl}}
                {{/sourceurl}}
            </div>
            {{/_disableContribution}}

            {{^_disableNextArticle}}
            <div class="next-article d-print-none border-top" id="nextArticle"></div>
            {{/_disableNextArticle}}
        </div>

        {{^_disableAffix}}
        <div class="affix">
            <nav id="affix"></nav>
        </div>
        {{/_disableAffix}}
    </main>

    {{#_enableSearch}}
    <div class="container-xxl search-results" id="search-results"></div>
    {{/_enableSearch}}

    <footer class="border-top text-secondary">
        <div class="container-xxl">
            <div class="flex-fill">
                {{{_appFooter}}}
                {{^_appFooter}}
                <span>
                    Made with <a href="https://dotnet.github.io/docfx">docfx</a>
                </span>
                {{/_appFooter}}
            </div>
        </div>
    </footer>

    <script>
        const fontSettings = [
            {
                type: 'document',
                selector: document.getElementById('document-font-selector'),
                input: document.getElementById('document-font-custom')
            },
            {
                type: 'code',
                selector: document.getElementById('code-font-selector'),
                input: document.getElementById('code-font-custom')
            }
        ];

        const fontRoot = document.documentElement;

        function applyFont(type, font) {
            const storageKey = `docfx-${type}-font`;

            localStorage.setItem(storageKey, font);
            fontRoot.setAttribute(`data-${type}-font`, font);

            if (font !== 'custom') {
                fontRoot.style.removeProperty(`--${type}-font`);
                return;
            }

            const setting = fontSettings.find(setting => setting.type === type);
            const customFont = setting?.input.value.trim() || '';

            if (customFont && CSS.supports('font-family', JSON.stringify(customFont))) {
                fontRoot.style.setProperty(
                    `--${type}-font`,
                    `${JSON.stringify(customFont)}, system-ui, sans-serif`
                );

                localStorage.setItem(`docfx-${type}-font-custom`, customFont);
            } else {
                fontRoot.style.setProperty(`--${type}-font`, 'system-ui, sans-serif');
            }
        }

        fontSettings.forEach(setting => {
            const { type, selector, input } = setting;

            if (!selector || !input) return;

            const storageKey = `docfx-${type}-font`;
            const customStorageKey = `docfx-${type}-font-custom`;

            const currentFont = localStorage.getItem(storageKey) || 'dpcomic';
            const customFont = localStorage.getItem(customStorageKey) || '';

            selector.value = currentFont;
            input.value = customFont;

            input.hidden = currentFont !== 'custom';

            selector.addEventListener('change', () => {
                const font = selector.value;

                input.hidden = font !== 'custom';

                applyFont(type, font);

                if (font === 'custom') {
                    input.focus();
                }
            });

            input.addEventListener('input', () => {
                const customFont = input.value.trim();

                localStorage.setItem(customStorageKey, customFont);

                if (selector.value === 'custom') {
                    applyFont(type, 'custom');
                }
            });
        });
    </script>

    <script>
        (() => {
            const fontSizeAndHeightRoot = document.documentElement;

            const sizeSettings = [
                {
                    id: 'document-font-size',
                    output: 'document-font-size-value',
                    storage: 'docfx-document-font-size',
                    property: '--document-font-size',
                    unit: 'px',
                    defaultValue: 20,
                    min: 12,
                    max: 32
                },
                {
                    id: 'code-font-size',
                    output: 'code-font-size-value',
                    storage: 'docfx-code-font-size',
                    property: '--code-font-size',
                    unit: 'px',
                    defaultValue: 18,
                    min: 10,
                    max: 28
                },
                {
                    id: 'document-line-height',
                    output: 'document-line-height-value',
                    storage: 'docfx-document-line-height',
                    property: '--document-line-height',
                    unit: '',
                    defaultValue: 1.5,
                    min: 1,
                    max: 2.5
                },
                {
                    id: 'code-line-height',
                    output: 'code-line-height-value',
                    storage: 'docfx-code-line-height',
                    property: '--code-line-height',
                    unit: '',
                    defaultValue: 1.4,
                    min: 1,
                    max: 2.5
                },
                {
                    id: 'heading-line-height',
                    output: 'heading-line-height-value',
                    storage: 'docfx-heading-line-height',
                    property: '--heading-line-height',
                    unit: '',
                    defaultValue: 1.2,
                    min: 1,
                    max: 2
                }
            ];

            sizeSettings.forEach(setting => {
                const input = document.getElementById(setting.id);
                const output = document.getElementById(setting.output);

                if (!input || !output) return;

                const savedValue = localStorage.getItem(setting.storage);
                const parsedValue = savedValue === null
                    ? setting.defaultValue
                    : Number(savedValue);

                const value = Number.isFinite(parsedValue)
                    ? Math.min(setting.max, Math.max(setting.min, parsedValue))
                    : setting.defaultValue;

                function applyValue(value) {
                    const formattedValue = setting.unit
                        ? `${value}${setting.unit}`
                        : Number(value).toFixed(1);

                    input.value = value;
                    output.textContent = formattedValue;

                    fontSizeAndHeightRoot.style.setProperty(
                        setting.property,
                        setting.unit ? formattedValue : value
                    );

                    localStorage.setItem(setting.storage, value);
                }

                applyValue(value);

                input.addEventListener('input', () => {
                    applyValue(Number(input.value));
                });
            });
        })();
    </script>

    <script>
        (() => {
            const navbar = document.getElementById('navbar');

            if (!navbar) return;

            function moveFontSettings() {
                const fontSettings = navbar.querySelector('.font-settings-menu');
                const themeSwitcher = navbar.querySelector('form.icons');

                if (!fontSettings || !themeSwitcher) return false;

                if (fontSettings.parentElement !== themeSwitcher) {
                    themeSwitcher.appendChild(fontSettings);
                }

                return true;
            }

            if (moveFontSettings()) return;

            const observer = new MutationObserver(() => {
                if (moveFontSettings()) {
                    observer.disconnect();
                }
            });

            observer.observe(navbar, {
                childList: true,
                subtree: true
            });
        })();
    </script>

    <script>
        (() => {
            const navPanel = document.getElementById('navpanel');
            const toggleButton = document.querySelector('[data-bs-target="#navpanel"]');
            const toggleLabel = toggleButton?.querySelector('.navbar-toggle-label');

            if (!navPanel || !toggleButton || !toggleLabel) return;

            navPanel.addEventListener('shown.bs.collapse', () => {
                toggleLabel.textContent = 'Hide Expanded Navbar';
                toggleButton.setAttribute('aria-label', 'Hide expanded navbar');
            });

            navPanel.addEventListener('hidden.bs.collapse', () => {
                toggleLabel.textContent = 'Show Expanded Navbar';
                toggleButton.setAttribute('aria-label', 'Show expanded navbar');
            });
        })();
    </script>
</body>
{{/redirect_url}}
</html>