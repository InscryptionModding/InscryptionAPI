{{!Licensed to the .NET Foundation under one or more agreements by the .NET Foundation. The .NET Foundation licenses this file to you under the MIT license.}}

{{>partials/class.header}}

{{#children}}

{{^_splitReference}}
<h2 class="section" id="{{id}}">{{>partials/classSubtitle}}</h2>
{{/_splitReference}}

{{#children}}

{{#overload}}
<a id="{{id}}" data-uid="{{uid}}" data-overload></a>
{{/overload}}

<h3 id="{{id}}" data-uid="{{uid}}">
  {{name.0.value}}
  {{#sourceurl}}<a class="header-action link-secondary" title="View source" href="{{sourceurl}}"><i class="bi bi-code-slash"></i></a>{{/sourceurl}}
</h3>

<div class="markdown level1 summary">
  <p>A brief description of this member and its intended purpose.</p>
  {{{summary}}}
</div>

<div class="markdown level1 conceptual">
  <p>Additional conceptual information explaining this member, its behavior, and how it should be used.</p>
  {{{conceptual}}}
</div>

{{#syntax}}
<div class="codewrapper">
  <pre><code class="lang-{{_lang}} hljs">{{syntax.content.0.value}}</code></pre>
</div>

{{#syntax.parameters.0}}
<h4 class="section">{{__global.parameters}}</h4>
<p>Lists the parameters accepted by this member, including their names, types, and descriptions.</p>

<table class="api-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.parameters.0}}

{{#syntax.parameters}}
    <tr>
      <td>
        <div class="parameter-type">
          {{{type.specName.0.value}}}
        </div>
        <div class="parametername">
          {{{id}}}
        </div>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.parameters}}

{{#syntax.parameters.0}}
  </tbody>
</table>
{{/syntax.parameters.0}}

{{#syntax.return}}
<h4 class="section">{{__global.returns}}</h4>
<p>Describes the value returned by this member, including its type and purpose.</p>

<table class="api-returns">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/syntax.return}}

{{#syntax.typeParameters.0}}
<h4 class="section">{{__global.typeParameters}}</h4>
<p>Lists the generic type parameters declared by this member, including their names and descriptions.</p>

<table class="api-type-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.typeParameters.0}}

{{#syntax.typeParameters}}
    <tr>
      <td>
        <span class="parametername">{{{id}}}</span>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.typeParameters}}

{{#syntax.typeParameters.0}}
  </tbody>
</table>
{{/syntax.typeParameters.0}}

{{#inEnum}}
{{#fieldValue}}
<h4 class="section">{{__global.fieldValue}}</h4>
<p>Specifies the constant value assigned to this enumeration member.</p>

<table class="api-returns">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/fieldValue}}
{{/inEnum}}

{{#propertyValue}}
<h4 class="section">Property Value</h4>
<p>Describes the value exposed by this property, including its type and purpose.</p>

<div class="property-value">
  <div class="parameter-type">
    {{{type.specName.0.value}}}
  </div>
  <div class="markdown">
    {{{description}}}
  </div>
</div>
{{/propertyValue}}

{{#eventType}}
<h4 class="section">{{__global.eventType}}</h4>
<p>Identifies the delegate type used by this event and describes its purpose.</p>

<table class="api-returns">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/eventType}}

{{/syntax}}

{{#example.0}}
<h4 class="section" id="{{id}}_examples">{{__global.examples}}</h4>
<p>Provides practical usage examples demonstrating how this member can be implemented or used.</p>
{{/example.0}}
{{#example}}
{{{.}}}
{{/example}}

{{#remarks}}
<h4 class="section" id="{{id}}_remarks">{{__global.remarks}}</h4>
<p>Provides additional information, implementation details, and considerations relevant to this member.</p>
<div class="markdown level1 remarks">{{{remarks}}}</div>
{{/remarks}}

{{#exceptions.0}}
<h4 class="section">{{__global.exceptions}}</h4>
<p>Lists the exceptions that may be thrown by this member and describes the conditions under which they occur.</p>

<table class="api-exceptions">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/exceptions.0}}

{{#exceptions}}
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
{{/exceptions}}

{{#exceptions.0}}
  </tbody>
</table>
{{/exceptions.0}}

{{#seealso.0}}
<dl class="typelist seealso">
  <dt>{{__global.seealso}}</dt>
  <dd>
    <p>References related types, members, and external resources that provide additional information.</p>
{{/seealso.0}}
{{#seealso}}
  {{#isCref}}
  <div>{{{type.specName.0.value}}}</div>
  {{/isCref}}
  {{^isCref}}
  <div>{{{url}}}</div>
  {{/isCref}}
{{/seealso}}
{{#seealso.0}}
  </dd>
</dl>
{{/seealso.0}}

{{/children}}
{{/children}}

{{#seealso.0}}
<h2 id="seealso">{{__global.seealso}}</h2>
<div class="seealso">
  <p>References related types, members, and external resources that provide additional information.</p>
{{/seealso.0}}
{{#seealso}}
  {{#isCref}}
    <div>{{{type.specName.0.value}}}</div>
  {{/isCref}}
  {{^isCref}}
    <div>{{{url}}}</div>
  {{/isCref}}
{{/seealso}}
{{#seealso.0}}
</div>
{{/seealso.0}}