{{!Licensed to the .NET Foundation under one or more agreements by the .NET Foundation. The .NET Foundation licenses this file to you under the MIT license.}}

{{>partials/class.header}}

{{#children}}

{{^_splitReference}}
<h2 class="section" id="{{id}}">{{>partials/classSubtitle}}</h2>
{{/_splitReference}}

{{#children}}

{{#overload}}
<a id="{{id}}" data-uid="{{uid}}" data-overload></a>
{{/overload}}

<h3 id="{{id}}" data-uid="{{uid}}">
  {{name.0.value}}
  {{#sourceurl}}<a class="header-action link-secondary" title="View source" href="{{sourceurl}}"><i class="bi bi-code-slash"></i></a>{{/sourceurl}}
</h3>

{{#summary}}
<div class="markdown level1 summary">
  <h4>{{__global.summary}}</h4>
  <p>The following is a breif description of what this member does, and what it is meant for: </p>
  {{{summary}}}
</div>
{{/summary}}

{{#conceptual}}
<div class="markdown level1 conceptual">
  <h4>{{__global.conceptual}}</h4>
  <p>The following is some breif conceptual information on how this member should be used: </p>
  {{{conceptual}}}
</div>
{{/conceptual}}

{{#syntax}}
<h4 id="{{id}}_syntax">
  {{__global.syntax}}
</h4>
<p>The following codeblock is the declaration syntax of this member found in the code: </p>

<div class="codewrapper">
  <pre><code class="lang-{{_lang}} hljs">{{syntax.content.0.value}}</code></pre>
</div>
{{/syntax}}

{{#syntax.parameters.0}}
<h4 class="section">{{__global.parameters}}</h4>
<p>The following table is a full list of parameters used by this member, in the form of <c>type, name | description</c> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.parameters.0}}

{{#syntax.parameters}}
    <tr>
      <td>
        <div class="parameter-type">
          {{{type.specName.0.value}}}
        </div>
        <div class="parametername">
          {{{id}}}
        </div>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.parameters}}

{{#syntax.parameters.0}}
  </tbody>
</table>
{{/syntax.parameters.0}}

{{#syntax.return}}
<h4 class="section">{{__global.returns}}</h4>
<p>The following table is a full list of returns used by this member, in the form of <c>type, name | description</c> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-returns">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/syntax.return}}

{{#syntax.typeParameters.0}}
<h4 class="section">{{__global.typeParameters}}</h4>
<p>The following table is a full list of Type Parameters used by this member, in the form of <c>type, name | description</c> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-type-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.typeParameters.0}}

{{#syntax.typeParameters}}
    <tr>
      <td>
        <span class="parametername">{{{id}}}</span>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.typeParameters}}

{{#syntax.typeParameters.0}}
  </tbody>
</table>
{{/syntax.typeParameters.0}}

{{#inEnum}}
{{#fieldValue}}
<h4 class="section">{{__global.fieldValue}}</h4>
<p>The following table is a full list of enumerations used by this member, in the form of <c>name | description</c> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-fields">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/fieldValue}}
{{/inEnum}}

{{#propertyValue}}
<h4 class="section">Property Value</h4>
<p>The following is the type associated with this member: </p>

<div class="property-value">
  <div class="parameter-type">
    {{{type.specName.0.value}}}
  </div>
  <div class="markdown">
    {{{description}}}
  </div>
</div>
{{/propertyValue}}

{{#eventType}}
<h4 class="section">{{__global.eventType}}</h4>
<p>The following is the event type associated with this member: </p>

<div class="event-type">
  <div class="parameter-type">
    {{{type.specName.0.value}}}
  </div>
  <div class="markdown">
    {{{description}}}
  </div>
</div>
{{/eventType}}

{{#example.0}}
<h4 class="section" id="{{id}}_examples">{{__global.examples}}</h4>
<p>The following is a example of how you can use this member: </p>
{{/example.0}}
{{#example}}
{{{.}}}
{{/example}}

{{#remarks}}
<h4 class="section" id="{{id}}_remarks">{{__global.remarks}}</h4>
<p>The following is additional information related to this member: </p>
<div class="markdown level1 remarks">{{{remarks}}}</div>
{{/remarks}}

{{#exceptions.0}}
<h4 class="section">{{__global.exceptions}}</h4>
<p>The following table is a full list of Exceptions used by this member, in the form of <c>type | description</c> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-exceptions">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/exceptions.0}}

{{#exceptions}}
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
{{/exceptions}}

{{#exceptions.0}}
  </tbody>
</table>
{{/exceptions.0}}

{{#seealso.0}}
<dl class="typelist seealso">
  <dt>{{__global.seealso}}</dt>
  <dd>
    <p>References in which have additional information related to how you can use this member, or functions and utilities that use this member: </p>
{{/seealso.0}}
{{#seealso}}
  {{#isCref}}
  <div>{{{type.specName.0.value}}}</div>
  {{/isCref}}
  {{^isCref}}
  <div>{{{url}}}</div>
  {{/isCref}}
{{/seealso}}
{{#seealso.0}}
  </dd>
</dl>
{{/seealso.0}}

{{/children}}
{{/children}}