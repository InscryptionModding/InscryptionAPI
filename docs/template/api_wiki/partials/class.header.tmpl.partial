{{!Licensed to the .NET Foundation under one or more agreements. The .NET Foundation licenses this file to you under the MIT license.}}

<h1 id="{{id}}" data-uid="{{uid}}" class="text-break">
  {{>partials/title}}
  {{#sourceurl}}<a class="header-action link-secondary" title="View source" href="{{sourceurl}}"><i class="bi bi-code-slash"></i></a>{{/sourceurl}}
</h1>

<div class="facts text-secondary">
  <dl><dt>{{__global.namespace}}</dt><dd>{{{namespace.specName.0.value}}}</dd></dl>
  {{#assemblies.0}}<dl><dt>{{__global.assembly}}</dt><dd>{{assemblies.0}}.dll</dd></dl>{{/assemblies.0}}
</div>

{{#summary}}
<div class="markdown summary">
  <h2>Summary</h2>
  <p>The following is a brief description of what this type does, and what it is meant for: </p>
  {{{summary}}}
</div>
{{/summary}}

{{#conceptual}}
<div class="markdown conceptual">
  <h2>Conceptual</h2>
  <p>The following is some brief conceptual information on how this type should be used: </p>
  {{{conceptual}}}
</div>
{{/conceptual}}

{{#inClass}}
<div class="inheritance">
  <h2>Inheritance</h2>
  <p>The following is the full inheritance tree for this type: </p>

  <div class="inheritance-tree">
    {{#inheritance}}
    <div class="inheritance-level" style="--inheritance-level: {{index}}">
      {{{specName.0.value}}}
    </div>
    {{/inheritance}}

    <div class="inheritance-level" style="--inheritance-level: {{level}}">
      <span class="xref">{{name.0.value}}</span>
    </div>

    {{#derivedClasses}}
    <div class="inheritance-level" style="--inheritance-level: {{index}}">
      {{{specName.0.value}}}
    </div>
    {{/derivedClasses}}
  </div>
</div>
{{/inClass}}

{{#implements.0}}
<div class="implements">
  <h2>Implements</h2>
  <p>The following are all of the interfaces implemented by this type: </p>
{{/implements.0}}

{{#implements}}
  <div>
    {{{specName.0.value}}}
  </div>
{{/implements}}

{{#implements.0}}
</div>
{{/implements.0}}

{{#syntax.content.0.value}}
<h2 id="{{id}}_syntax">
  Syntax
</h2>
<p>The following codeblock is the declaration syntax of this type found in the code: </p>

<div class="codewrapper">
  <pre><code class="lang-{{_lang}} hljs">{{syntax.content.0.value}}</code></pre>
</div>
{{/syntax.content.0.value}}

{{#syntax.parameters.0}}
<h2 class="parameters">
  Parameters
</h2>
<p>The following table is a full list of parameters used by this type, in the form of <code>type, name | description</code> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.parameters.0}}

{{#syntax.parameters}}
    <tr>
      <td>
        <div class="parameter-type">
          {{{type.specName.0.value}}}
        </div>
        <div class="parametername">
          {{{id}}}
        </div>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.parameters}}

{{#syntax.parameters.0}}
  </tbody>
</table>
{{/syntax.parameters.0}}

{{#syntax.return}}
<h2 class="returns">
  Returns
</h2>
<p>The following table is a full list of returns used by this type, in the form of <code>type, name | description</code> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-returns">
  <thead>
    <tr>
      <th>{{__global.type}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
    <tr>
      <td>{{{type.specName.0.value}}}</td>
      <td>{{{description}}}</td>
    </tr>
  </tbody>
</table>
{{/syntax.return}}

{{#syntax.typeParameters.0}}
<h2 class="typeParameters">
  Type Parameters
</h2>

<p>The following table is a full list of Type Parameters used by this type, in the form of <code>type, name | description</code> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-type-parameters">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
{{/syntax.typeParameters.0}}

{{#syntax.typeParameters}}
    <tr>
      <td>
        <span class="parametername">{{{id}}}</span>
      </td>
      <td>{{{description}}}</td>
    </tr>
{{/syntax.typeParameters}}

{{#syntax.typeParameters.0}}
  </tbody>
</table>
{{/syntax.typeParameters.0}}

{{#inheritedMembers.0}}
<details class="typelist inheritedMembers">
  <summary>
    <h2 class="inheritedMembers">Inherited Members (Click me to Expand)</h2>
  </summary>
  <p>The following are inherited members derived from this type's inheritence: </p>
  <div class="typelist-content">
{{/inheritedMembers.0}}

{{#inheritedMembers}}
    <div>
    {{#definition}}
      <xref uid="{{definition}}" text="{{nameWithType.0.value}}" alt="{{fullName.0.value}}"/>
    {{/definition}}
    {{^definition}}
      <xref uid="{{uid}}" text="{{nameWithType.0.value}}" alt="{{fullName.0.value}}"/>
    {{/definition}}
    </div>
{{/inheritedMembers}}

{{#inheritedMembers.0}}
  </div>
</details>
{{/inheritedMembers.0}}

{{#extensionMethods.0}}
<details class="typelist extensionMethods">
  <summary>
    <h2 class="extensionMethods">Extension Methods (Click me to Expand)</h2>
  </summary>
  <p>The following are methods in which you can use that act as extensions to this type: </p>
  <div class="typelist-content">
{{/extensionMethods.0}}

{{#extensionMethods}}
    <div>
    {{#definition}}
      <xref uid="{{definition}}" altProperty="fullName" displayProperty="nameWithType"/>
    {{/definition}}
    {{^definition}}
      <xref uid="{{uid}}" altProperty="fullName" displayProperty="nameWithType"/>
    {{/definition}}
    </div>
{{/extensionMethods}}

{{#extensionMethods.0}}
  </div>
</details>
{{/extensionMethods.0}}

{{#isEnum}}
{{#children}}
<h2 id="{{id}}">{{>partials/classSubtitle}}</h2>
<p>The following table is a full list of enumerations used by this type, in the form of <code>name | description</code> for your ease of convenience, if you don't know what a given type is, you can click it and it will link to its definition at the associated documentation. The table is below: </p>

<table class="api-fields">
  <thead>
    <tr>
      <th>{{__global.name}}</th>
      <th>{{__global.description}}</th>
    </tr>
  </thead>

  <tbody>
  {{#children}}
    <tr>
      <td>
        <code>{{syntax.content.0.value}}</code>
      </td>
      <td>
        {{{summary}}}
        {{#remarks}}{{{remarks}}}{{/remarks}}
      </td>
    </tr>
  {{/children}}
  </tbody>
</table>

{{/children}}
{{/isEnum}}

{{#example.0}}
<h2 id="{{id}}_examples">Examples</h2>
<p>The following is an example of how you can use this type: </p>
{{/example.0}}
{{#example}}
{{{.}}}
{{/example}}

{{#remarks}}
<h2 id="{{id}}_remarks">Remarks</h2>
<p>The following is additional information related to this type: </p>
<div class="markdown level0 remarks">{{{remarks}}}</div>
{{/remarks}}

{{#seealso.0}}
<h2 id="seealso">See Also</h2>
<div class="seealso">
  <p>References related types, members, and external resources that provide additional information.</p>
{{/seealso.0}}
{{#seealso}}
  {{#isCref}}
    <div>{{{type.specName.0.value}}}</div>
  {{/isCref}}
  {{^isCref}}
    <div>{{{url}}}</div>
  {{/isCref}}
{{/seealso}}
{{#seealso.0}}
</div>
{{/seealso.0}}