<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netframework4.7.2</TargetFrameworks>
        <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <AssemblyName>InscryptionAPI</AssemblyName>
        <Description>The Core API for the game Inscryption.</Description>
        <Version>2.24.2</Version>
        <Authors>Cyantist, IngoH, WhistleWind, Chaosyr and Contibutors</Authors>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>Latest</LangVersion>
        <RootNamespace>InscryptionAPI</RootNamespace>
        <DebugType>full</DebugType>
        <NoWarn>$(NoWarn);AD0001;CS0612;CS8604;CS0252;CS0618;Harmony003;Publicizer001</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <SelfContained>true</SelfContained>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Talking Card Prefab -->
        <None Remove="$(ProjectDir)\TalkingCards\talkingcardgenericprefab" />
        <EmbeddedResource Include="$(ProjectDir)\TalkingCards\talkingcardgenericprefab">
            <LogicalName>TalkingCardGenericPrefab</LogicalName>
        </EmbeddedResource>
        <!-- Base Game Decals -->
        <None Remove="$(ProjectDir)\Assets\*" />
        <EmbeddedResource Include="$(ProjectDir)\Assets\*" />
        <None Remove="Assets\BaseGameDecals\decal_blood_1.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_blood_1.png" />
        <None Remove="Assets\BaseGameDecals\decal_blood_2.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_blood_2.png" />
        <None Remove="Assets\BaseGameDecals\decal_blood_3.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_blood_3.png" />
        <None Remove="Assets\BaseGameDecals\decal_blood_4.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_blood_4.png" />
        <None Remove="Assets\BaseGameDecals\decal_child.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_child.png" />
        <None Remove="Assets\BaseGameDecals\decal_fungus.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_fungus.png" />
        <None Remove="Assets\BaseGameDecals\decal_smoke.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_smoke.png" />
        <None Remove="Assets\BaseGameDecals\decal_smoke_abilityhole.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_smoke_abilityhole.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_1.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_1.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_2.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_2.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_3.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_3.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_4.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_4.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_5.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_5.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_6.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_6.png" />
        <None Remove="Assets\BaseGameDecals\decal_snelk_main.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_snelk_main.png" />
        <None Remove="Assets\BaseGameDecals\decal_stitches.png" />
        <EmbeddedResource Include="Assets\BaseGameDecals\decal_stitches.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Core" Version="5.4.21" />
        <PackageReference Include="HarmonyX" Version="2.10.2" />
        <PackageReference Include="Inscryption.GameLibs" Version="1.9.0-r.0" />
        <PackageReference Include="UnityEngine.Modules" Version="2019.4.24" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Assets\BaseGameDecals\" />
    </ItemGroup>

    <!--Net Framework References-->
    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <!--Cleanup Publish for our Build System-->
    <Target Name="StripAllNuGetFromPublish" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' and '%(ResolvedFileToPublish.RelativePath)' != 'InscryptionAPI.dll'" />
        </ItemGroup>
    </Target>

    <!--TS Build Setup-->
    <PropertyGroup>
        <!--Secondary CSProjs-->
        <SecondaryCSProjLocations>"../InscryptionCommunityPatch/InscryptionCommunityPatch.csproj"</SecondaryCSProjLocations>
        <!--Copy Locations-->
        <BuildCopyLocations>Thunderstore-Package-Elements</BuildCopyLocations>
        <BuildOutputLocations>plugins</BuildOutputLocations>
        <CHANGELOGCopyLocation>..\CHANGELOG.md</CHANGELOGCopyLocation>
        <READMECopyLocation>..\README.md</READMECopyLocation>
        <LICENSECopyLocation>..\LICENSE.md</LICENSECopyLocation>
        <ReleaseMode>Release</ReleaseMode>
        <!--Thunderstore Manifest Properties-->
        <ThunderstorePackageName>API</ThunderstorePackageName>
        <ThunderstorePackageVersion>2.24.2</ThunderstorePackageVersion>
        <ThunderstoreWebsiteURL>https://github.com/InscryptionModding/InscryptionAPI/</ThunderstoreWebsiteURL>
        <ThunderstorePackageDescription>The de-facto standard core API for all Inscryption mods. This lets you create new cards, abilities, challenges, map nodes, starter decks, and more.</ThunderstorePackageDescription>
        <ThunderstorePackageDependencyStrings>BepInEx-BepInExPack_Inscryption-5.4.2306;BepInEx-MonoMod_Loader_Inscryption-1.0.0</ThunderstorePackageDependencyStrings>
    </PropertyGroup>
</Project>
